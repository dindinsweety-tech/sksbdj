[Unit]
Description=Autocar71 lead receiver
Documentation=https://autocar71.ru
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autocar
Group=autocar
WorkingDirectory=/opt/autocar-lead/server
EnvironmentFile=/opt/autocar-lead/server/.env
ExecStart=/usr/bin/node --experimental-sqlite src/index.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

# Изоляция
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/autocar-lead /var/log/autocar-lead
StateDirectory=autocar-lead
LogsDirectory=autocar-lead

[Install]
WantedBy=multi-user.target
