# --- HTTP ---
PORT=8080
HOST=127.0.0.1
ALLOW_ORIGIN=https://autocar71.ru

# --- Хранилище ---
DB_FILE=/var/lib/autocar-lead/leads.db
LOG_FILE=/var/log/autocar-lead/app.log
LOG_LEVEL=info

# --- Корпоративный MAX (получить у заказчика) ---
MAX_API_URL=
MAX_API_TOKEN=
MAX_CHAT_ID=
# Отдельный поток для лидов, не прошедших по критериям (возраст/стаж/гражданство).
# Если не задан — используется MAX_CHAT_ID.
MAX_COLD_CHAT_ID=
MAX_TIMEOUT_MS=7000

# --- Резервный канал, если MAX недоступен дольше FALLBACK_AFTER_MS ---
FALLBACK_AFTER_MS=600000
FALLBACK_TG_TOKEN=
FALLBACK_TG_CHAT=

# --- reCAPTCHA v3 (secret только здесь, в Tilda уходит site key) ---
RECAPTCHA_SECRET=
RECAPTCHA_THRESHOLD=0.3

# --- Защита и 152-ФЗ ---
RATE_LIMIT=10
RATE_WINDOW_MS=600000
IP_SALT=поменять-на-случайную-строку
POLICY_VERSION=2026-09-17
